# ── Node dependencies ────────────────────────────────
node_modules/

# ── Build output (regenerated on build) ──────────────
out/
dist/
release/
*.tsbuildinfo

# ── Electron packaged installers ─────────────────────
*.dmg
*.AppImage
*.snap
*.deb
*.exe
*.blockmap
latest.yml

# ── Auto-generated MediaPipe runtime (~35 MB) ────────
# Regenerated by `npm install` → scripts/copy-mediapipe.mjs
src/renderer/public/mediapipe/

# ── Python backend ───────────────────────────────────
backend/venv/
venv/
.venv/
env/
ENV/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/

# ── Downloaded ML models (keep the folder) ───────────
backend/models/*
!backend/models/.gitkeep

# ── Logs ─────────────────────────────────────────────
*.log*

# ── Env / secrets ────────────────────────────────────
.env
.env.*
!.env.example

# ── Editor / OS junk ─────────────────────────────────
.DS_Store
Thumbs.db
*.swp
.idea/

# ── Tooling caches ───────────────────────────────────
.eslintcache
.vite/
.omo/
